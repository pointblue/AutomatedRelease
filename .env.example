GITHUB_TOKEN='your GitHub token'
ORG_NAME='your-org-name'
TEAM_NAME='your-team-name'
DEPLOYABLE_TOPIC='deployer-php'
# Optional. Comma-separated, highest priority first. A pattern with '*' is a
# glob; any other pattern is an exact match. Both are matched against the
# repo's full name (org/repo) and short name. Repos matching an earlier
# pattern are listed first in the release notes; unmatched repos go last.
# Within a group, repos are ordered alphabetically. Unset = alphabetical.
# Example: *dblib*,myorg/api,*auth*,my-login-app
RELEASE_REPO_ORDER=''
DATE_RANGE_TZ_OFFSET='0'
WEEK_OFFSET=''
CONFLUENCE_EMAIL='your-email@example.com'
CONFLUENCE_API_TOKEN='your-confluence-api-token'

# Deployment settings (used by deploy-release.py). The script runs as DEPLOY_USER
# wherever the repos are cloned, and drives the deploy/rollback commands below.
DEPLOY_USER=''
# Directory holding the cloned repos (repo dir names match GitHub names).
DEPLOY_SOURCE_REPO_PATH=''
# Deploy/rollback commands; the deploy target is appended as the next argument.
DEPLOY_DEPLOY_COMMAND=''
DEPLOY_ROLLBACK_COMMAND=''
# Flag the deploy command uses to deploy a specific revision.
DEPLOY_DEPLOY_COMMAND_REVISION_FLAG=''
# Default deploy target; overridable per-run with target=<name>.
DEPLOY_DEFAULT_DEPLOY_TARGET=''
# Per-repo JSON file describing the last deployment, and the keys within it that
# hold the currently-deployed branch and revision SHA.
DEPLOY_REPO_DEPLOY_STATUS_FILENAME=''
DEPLOY_REPO_DEPLOY_STATUS_BRANCH_KEY=''
DEPLOY_REPO_DEPLOY_STATUS_REV_KEY=''